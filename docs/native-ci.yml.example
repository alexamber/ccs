name: Native macOS checks
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  native:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4
      - name: Swift regression tests
        run: swift test
      - name: Build universal development package
        run: bash scripts/build-app.sh --development
      - name: Packaged CLI and terminal smoke checks
        run: python3 scripts/check-native.py build/CCS.app/Contents/MacOS/ccs
      - name: Preserve development downloads
        uses: actions/upload-artifact@v4
        with:
          name: CCS-development-macos-universal
          path: dist/*-development.*
